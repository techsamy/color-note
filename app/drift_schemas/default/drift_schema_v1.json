    {
      "name": "notes_fts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE VIRTUAL TABLE IF NOT EXISTS \"notes_fts\" USING fts5(note_id UNINDEXED, title, body, tokenize = 'unicode61 remove_diacritics 2');"
