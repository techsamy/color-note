    },
    {
      "name": "notes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"notes\" (\"id\" TEXT NOT NULL, \"type\" INTEGER NOT NULL, \"title\" TEXT NOT NULL DEFAULT '', \"body\" TEXT NOT NULL DEFAULT '', \"color\" INTEGER NOT NULL, \"is_pinned\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_pinned\" IN (0, 1)), \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"is_locked\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_locked\" IN (0, 1)), \"crypto_meta\" TEXT NULL, \"reminder_at\" INTEGER NULL, \"reminder_rule\" TEXT NULL, \"reminder_all_day\" INTEGER NOT NULL DEFAULT 0 CHECK (\"reminder_all_day\" IN (0, 1)), \"status_bar_pinned\" INTEGER NOT NULL DEFAULT 0 CHECK (\"status_bar_pinned\" IN (0, 1)), \"calendar_date\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"base_version\" INTEGER NOT NULL DEFAULT 0, \"dirty\" INTEGER NOT NULL DEFAULT 1 CHECK (\"dirty\" IN (0, 1)), \"owner_user_uuid\" TEXT NULL, \"my_permission\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "color_labels",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"color_labels\" (\"color\" INTEGER NOT NULL, \"label\" TEXT NOT NULL, \"updated_at\" INTEGER NOT NULL, \"dirty\" INTEGER NOT NULL DEFAULT 1 CHECK (\"dirty\" IN (0, 1)), \"base_version\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"color\"));"
        }
      ]
    },
